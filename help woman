let gameIndex = 0;


function gameAnswer(answer) {

    const situation =
        gameSituations[gameIndex];


    const feedback =
        document.getElementById("game-feedback");


    if (answer === situation.answer) {

        feedback.textContent =
            "✨ Isso! " + situation.explanation;

    } else {

        feedback.textContent =
            "🌷 Observe esse comportamento: " +
            situation.explanation;

    }


    gameIndex++;


    if (gameIndex >= gameSituations.length) {

        gameIndex = 0;

    }


    setTimeout(() => {

        document.getElementById("game-text")
            .textContent =
            gameSituations[gameIndex].text;

        feedback.textContent = "";

    }, 3500);

}


