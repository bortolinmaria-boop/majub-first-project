<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Você Não Está Sozinha</title>

    <meta
        name="description"
        content="Informação, acolhimento e apoio para mulheres que enfrentam violência."
    >

    <link rel="stylesheet" href="style.css">

    <link
        rel="preconnect"
        href="https://fonts.googleapis.com"
    >

    <link
        href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap"
        rel="stylesheet"
    >
</head>

<body>

    <!-- BOTÃO DE SAÍDA -->
    <button class="exit-button" onclick="quickExit()">
        ✕ Sair rapidamente
    </button>


    <!-- NAVEGAÇÃO -->

    <header>

        <nav class="navbar">

            <div class="logo">
                <span>✿</span>
                Você Não Está Sozinha
            </div>

            <div class="nav-links">

                <a href="#inicio">Início</a>
                <a href="#quiz">Quiz</a>
                <a href="#sinais">Sinais</a>
                <a href="#ajuda">Ajuda</a>

            </div>

        </nav>

    </header>


    <!-- HERO -->

    <main id="inicio">

        <section class="hero">

            <div class="hero-content">

                <span class="tag">
                    UM ESPAÇO DE ACOLHIMENTO
                </span>

                <h1>
                    Nem toda violência
                    <span>deixa marcas visíveis.</span>
                </h1>

                <p>
                    Controle, humilhação, ameaças, isolamento e medo
                    também podem ser sinais de violência.
                    Você merece respeito, segurança e liberdade.
                </p>

                <div class="hero-buttons">

                    <a href="#quiz" class="btn primary">
                        Fazer o quiz →
                    </a>

                    <a href="#ajuda" class="btn secondary">
                        Preciso de ajuda
                    </a>

                </div>

            </div>


            <div class="hero-image">

                <div class="image-card">

                    <img
                        src="https://images.unsplash.com/photo-1544005313-94ddf0286df2?auto=format&fit=crop&w=900&q=80"
                        alt="Mulher sorrindo"
                    >

                    <div class="floating-card">

                        <span>💜</span>

                        <div>
                            <strong>Você importa.</strong>
                            <small>Você merece ser ouvida.</small>
                        </div>

                    </div>

                </div>

            </div>

        </section>


        <!-- FRASE -->

        <section class="quote-section">

            <div class="quote">
                <span>“</span>

                <h2>
                    O amor não controla,
                    não ameaça e não machuca.
                </h2>

                <p>
                    Um relacionamento saudável respeita seus limites,
                    sua liberdade e suas escolhas.
                </p>

            </div>

        </section>


        <!-- QUIZ -->

        <section id="quiz" class="section quiz-section">

            <div class="section-title">

                <span class="tag">
                    QUIZ INTERATIVO
                </span>

                <h2>
                    Como está o seu relacionamento?
                </h2>

                <p>
                    Responda algumas perguntas sobre situações
                    que podem acontecer em um relacionamento.
                </p>

            </div>


            <div class="quiz-container">

                <div id="quiz-progress">

                    <div class="progress-bar">

                        <div id="progress"></div>

                    </div>

                    <span id="question-number">
                        Pergunta 1 de 10
                    </span>

                </div>


                <div id="question-box">

                    <h3 id="question">
                        Carregando...
                    </h3>

                    <div id="answers"></div>

                </div>


                <div id="quiz-result" class="hidden">

                    <div id="result-icon">
                        💜
                    </div>

                    <h2 id="result-title">
                        Resultado
                    </h2>

                    <p id="result-text"></p>

                    <button
                        class="btn primary"
                        onclick="restartQuiz()"
                    >
                        Refazer o quiz
                    </button>

                </div>

            </div>

        </section>


        <!-- SINAIS -->

        <section id="sinais" class="section signs-section">

            <div class="section-title">

                <span class="tag">
                    RECONHEÇA OS SINAIS
                </span>

                <h2>
                    Isso também pode ser violência.
                </h2>

                <p>
                    Nem sempre a violência começa com agressão física.
                </p>

            </div>


            <div class="cards">

                <article class="info-card">

                    <div class="card-icon">🧠</div>

                    <h3>Violência psicológica</h3>

                    <p>
                        Humilhações, ameaças, manipulação,
                        controle e medo constante.
                    </p>

                </article>


                <article class="info-card">

                    <div class="card-icon">💰</div>

                    <h3>Violência patrimonial</h3>

                    <p>
                        Controle do dinheiro, documentos,
                        cartões ou destruição de objetos.
                    </p>

                </article>


                <article class="info-card">

                    <div class="card-icon">❤️</div>

                    <h3>Violência sexual</h3>

                    <p>
                        Ignorar seu consentimento ou pressionar
                        você a fazer algo que não deseja.
                    </p>

                </article>


                <article class="info-card">

                    <div class="card-icon">🗣️</div>

                    <h3>Violência moral</h3>

                    <p>
                        Insultos, acusações, humilhações
                        e difamações.
                    </p>

                </article>


                <article class="info-card">

                    <div class="card-icon">👊</div>

                    <h3>Violência física</h3>

                    <p>
                        Empurrões, tapas, socos e
                        outras agressões físicas.
                    </p>

                </article>


                <article class="info-card">

                    <div class="card-icon">🚪</div>

                    <h3>Isolamento</h3>

                    <p>
                        Impedir você de ver amigos,
                        familiares ou pessoas de confiança.
                    </p>

                </article>

            </div>

        </section>


        <!-- AMOR OU CONTROLE -->

        <section class="game-section">

            <div class="game-content">

                <span class="tag">
                    VOCÊ CONSEGUE IDENTIFICAR?
                </span>

                <h2>
                    Amor ou controle?
                </h2>

                <p id="game-text">
                    “Me manda sua localização.
                    É porque eu me preocupo com você.”
                </p>

                <div class="game-buttons">

                    <button
                        onclick="gameAnswer('amor')"
                        class="game-btn"
                    >
                        ❤️ Amor
                    </button>

                    <button
                        onclick="gameAnswer('controle')"
                        class="game-btn"
                    >
                        🚩 Controle
                    </button>

                </div>

                <div id="game-feedback"></div>

            </div>

        </section>


        <!-- HISTÓRIA -->

        <section class="story-section">

            <div class="story-image">

                <img
                    src="https://images.unsplash.com/photo-1488426862026-3ee34a7d66df?auto=format&fit=crop&w=900&q=80"
                    alt="Mulher olhando pela janela"
                >

            </div>

            <div class="story-content">

                <span class="tag">
                    UMA REFLEXÃO
                </span>

                <h2>
                    “Ele só faz isso porque me ama.”
                </h2>

                <p>
                    Ciúmes excessivos, controle, invasão de privacidade
                    e medo não são provas de amor.
                </p>

                <p>
                    Se você sente que precisa mudar quem é para evitar
                    uma reação do seu parceiro, vale a pena conversar
                    com alguém de confiança e buscar orientação.
                </p>

                <a href="#ajuda" class="text-link">
                    Encontrar ajuda →
                </a>

            </div>

        </section>


        <!-- AJUDA -->

        <section id="ajuda" class="help-section">

            <div class="help-content">

                <span class="tag light">
                    VOCÊ NÃO PRECISA PASSAR POR ISSO SOZINHA
                </span>

                <h2>
                    Precisa de ajuda?
                </h2>

                <p>
                    Se você estiver em perigo imediato, procure
                    os serviços de emergência da sua região.
                </p>


                <div class="help-cards">

                    <div class="help-card">

                        <span>📞</span>

                        <div>

                            <strong>180</strong>

                            <p>
                                Central de Atendimento à Mulher
                            </p>

                        </div>

                    </div>


                    <div class="help-card">

                        <span>🚨</span>

                        <div>

                            <strong>190</strong>

                            <p>
                                Emergência policial
                            </p>

                        </div>

                    </div>

                </div>

            </div>

        </section>


        <!-- MENSAGEM FINAL -->

        <section class="final-section">

            <div class="flower">
                ✿
            </div>

            <h2>
                Você merece uma vida
                sem medo.
            </h2>

            <p>
                Sua história importa.
                Sua segurança importa.
                Você importa.
            </p>

        </section>

    </main>


    <!-- FOOTER -->

    <footer>

        <div class="footer-logo">
            ✿ Você Não Está Sozinha
        </div>

        <p>
            Informação também é uma forma de proteção.
        </p>

        <small>
            Este site possui caráter informativo e não substitui
            orientação profissional.
        </small>

    </footer>


    <script src="script.js"></script>

</body>

</html>
:root {
    --purple: #6f4b78;
    --purple-dark: #432d4a;
    --purple-light: #f3e9f4;

    --pink: #c8758f;
    --pink-light: #f8e7eb;

    --cream: #fffaf7;
    --text: #302832;
    --muted: #766d76;

    --white: #ffffff;

    --shadow:
        0 20px 60px rgba(72, 45, 75, 0.12);
}


* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}


html {
    scroll-behavior: smooth;
}


body {
    font-family: "DM Sans", sans-serif;

    background: var(--cream);

    color: var(--text);

    line-height: 1.6;
}


h1,
h2 {
    font-family: "Playfair Display", serif;
}


img {
    width: 100%;
    display: block;
}


a {
    text-decoration: none;
    color: inherit;
}


/* NAVBAR */

header {
    position: absolute;

    top: 0;
    left: 0;

    width: 100%;

    z-index: 20;
}


.navbar {
    max-width: 1200px;

    margin: auto;

    padding: 25px 30px;

    display: flex;

    justify-content: space-between;

    align-items: center;
}


.logo {
    color: var(--purple-dark);

    font-weight: 700;

    font-size: 18px;
}


.logo span {
    color: var(--pink);

    font-size: 25px;
}


.nav-links {
    display: flex;

    gap: 30px;
}


.nav-links a {
    color: var(--purple-dark);

    font-size: 14px;

    font-weight: 600;

    transition: .3s;
}


.nav-links a:hover {
    color: var(--pink);
}


/* EXIT */

.exit-button {
    position: fixed;

    right: 20px;
    bottom: 20px;

    z-index: 100;

    border: none;

    padding: 12px 18px;

    border-radius: 50px;

    background: #302832;

    color: white;

    cursor: pointer;

    box-shadow: var(--shadow);
}


/* HERO */

.hero {
    min-height: 100vh;

    display: grid;

    grid-template-columns: 1fr 1fr;

    align-items: center;

    gap: 60px;

    max-width: 1200px;

    margin: auto;

    padding: 120px 30px 80px;
}


.hero-content {
    max-width: 570px;
}


.tag {
    display: inline-block;

    color: var(--pink);

    font-size: 12px;

    font-weight: 700;

    letter-spacing: 2px;

    margin-bottom: 18px;
}


.hero h1 {
    font-size: clamp(45px, 6vw, 76px);

    line-height: 1.05;

    margin-bottom: 25px;
}


.hero h1 span {
    color: var(--purple);
}


.hero p {
    color: var(--muted);

    font-size: 18px;

    max-width: 540px;

    margin-bottom: 35px;
}


.hero-buttons {
    display: flex;

    gap: 15px;

    flex-wrap: wrap;
}


.btn {
    display: inline-flex;

    align-items: center;

    justify-content: center;

    padding: 15px 25px;

    border-radius: 50px;

    font-weight: 700;

    transition: .3s;

    border: none;

    cursor: pointer;
}


.primary {
    background: var(--purple);

    color: white;

    box-shadow:
        0 10px 25px rgba(111, 75, 120, .25);
}


.primary:hover {
    transform: translateY(-3px);

    background: var(--purple-dark);
}


.secondary {
    border: 1px solid #ddd0df;

    color: var(--purple);
}


.secondary:hover {
    background: var(--purple-light);
}


/* HERO IMAGE */

.hero-image {
    position: relative;
}


.image-card {
    position: relative;

    border-radius: 35px;

    overflow: hidden;

    box-shadow: var(--shadow);

    transform: rotate(2deg);
}


.image-card img {
    height: 600px;

    object-fit: cover;
}


.floating-card {
    position: absolute;

    bottom: 25px;
    left: 25px;
    right: 25px;

    background: rgba(255, 255, 255, .92);

    backdrop-filter: blur(10px);

    padding: 18px;

    border-radius: 20px;

    display: flex;

    gap: 15px;

    align-items: center;
}


.floating-card span {
    font-size: 30px;
}


.floating-card small {
    display: block;

    color: var(--muted);
}


/* QUOTE */

.quote-section {
    padding: 110px 30px;

    background: var(--purple-light);

    text-align: center;
}


.quote {
    max-width: 800px;

    margin: auto;
}


.quote > span {
    font-family: serif;

    font-size: 90px;

    color: var(--pink);

    height: 50px;

    display: block;
}


.quote h2 {
    font-size: clamp(30px, 5vw, 50px);

    color: var(--purple-dark);

    margin-bottom: 20px;
}


.quote p {
    color: var(--muted);
}


/* SECTIONS */

.section {
    max-width: 1200px;

    margin: auto;

    padding: 120px 30px;
}


.section-title {
    max-width: 650px;

    margin-bottom: 60px;
}


.section-title h2 {
    font-size: clamp(35px, 5vw, 55px);

    line-height: 1.1;

    margin-bottom: 18px;
}


.section-title p {
    color: var(--muted);
}


/* QUIZ */

.quiz-section {
    text-align: center;
}


.quiz-container {
    max-width: 720px;

    margin: auto;

    background: white;

    padding: 45px;

    border-radius: 30px;

    box-shadow: var(--shadow);

    text-align: left;
}


.progress-bar {
    height: 8px;

    background: #eee5ee;

    border-radius: 10px;

    overflow: hidden;

    margin-bottom: 12px;
}


#progress {
    height: 100%;

    width: 10%;

    background: var(--pink);

    transition: .4s;
}


#question-number {
    font-size: 13px;

    color: var(--muted);
}


#question-box h3 {
    font-size: 25px;

    margin: 40px 0 25px;
}


.answer {
    width: 100%;

    padding: 18px;

    margin-bottom: 12px;

    border-radius: 15px;

    border: 1px solid #e6dce7;

    background: white;

    text-align: left;

    cursor: pointer;

    transition: .25s;

    font-size: 15px;
}


.answer:hover {
    background: var(--purple-light);

    border-color: var(--purple);
}


#quiz-result {
    text-align: center;

    padding: 20px;
}


#result-icon {
    font-size: 55px;

    margin-bottom: 15px;
}


#result-title {
    font-family: "Playfair Display", serif;

    font-size: 35px;

    color: var(--purple);
}


#result-text {
    color: var(--muted);

    margin: 20px auto 30px;

    max-width: 500px;
}


.hidden {
    display: none;
}


/* CARDS */

.signs-section {
    max-width: 1200px;
}


.cards {
    display: grid;

    grid-template-columns:
        repeat(3, 1fr);

    gap: 20px;
}


.info-card {
    background: white;

    padding: 30px;

    border-radius: 25px;

    box-shadow:
        0 10px 30px rgba(72, 45, 75, .07);

    transition: .3s;
}


.info-card:hover {
    transform: translateY(-7px);
}


.card-icon {
    font-size: 35px;

    margin-bottom: 20px;
}


.info-card h3 {
    margin-bottom: 10px;
}


.info-card p {
    color: var(--muted);

    font-size: 14px;
}


/* GAME */

.game-section {
    padding: 120px 30px;

    background:
        linear-gradient(
            135deg,
            #f7e9ed,
            #eee5f2
        );

    text-align: center;
}


.game-content {
    max-width: 700px;

    margin: auto;
}


.game-content h2 {
    font-size: 55px;

    margin-bottom: 25px;
}


.game-content p {
    font-size: 22px;

    color: var(--purple-dark);

    margin-bottom: 30px;
}


.game-buttons {
    display: flex;

    justify-content: center;

    gap: 15px;

    flex-wrap: wrap;
}


.game-btn {
    padding: 15px 30px;

    border-radius: 50px;

    border: none;

    background: white;

    color: var(--purple-dark);

    font-weight: 700;

    cursor: pointer;

    box-shadow: 0 8px 20px rgba(0,0,0,.06);
}


#game-feedback {
    margin-top: 25px;

    font-weight: 700;

    min-height: 30px;
}


/* STORY */

.story-section {
    max-width: 1200px;

    margin: auto;

    padding: 120px 30px;

    display: grid;

    grid-template-columns: 1fr 1fr;

    gap: 80px;

    align-items: center;
}


.story-image {
    border-radius: 30px;

    overflow: hidden;

    box-shadow: var(--shadow);
}


.story-image img {
    height: 550px;

    object-fit: cover;
}


.story-content h2 {
    font-size: 50px;

    line-height: 1.1;

    margin-bottom: 25px;
}


.story-content p {
    color: var(--muted);

    margin-bottom: 20px;
}


.text-link {
    color: var(--purple);

    font-weight: 700;
}


/* HELP */

.help-section {
    background: var(--purple);

    color: white;

    padding: 100px 30px;
}


.help-content {
    max-width: 900px;

    margin: auto;
}


.light {
    color: #e8cddd;
}


.help-content h2 {
    font-size: 60px;

    margin-bottom: 20px;
}


.help-content > p {
    max-width: 600px;

    color: #e7dce9;

    margin-bottom: 40px;
}


.help-cards {
    display: grid;

    grid-template-columns: 1fr 1fr;

    gap: 20px;
}


.help-card {
    background: rgba(255,255,255,.1);

    border: 1px solid rgba(255,255,255,.15);

    padding: 25px;

    border-radius: 20px;

    display: flex;

    align-items: center;

    gap: 20px;
}


.help-card > span {
    font-size: 35px;
}


.help-card strong {
    font-size: 30px;
}


.help-card p {
    color: #e7dce9;
}


/* FINAL */

.final-section {
    text-align: center;

    padding: 120px 30px;
}


.flower {
    font-size: 60px;

    color: var(--pink);

    animation: float 3s ease-in-out infinite;
}


.final-section h2 {
    font-size: clamp(40px, 6vw, 65px);

    color: var(--purple-dark);

    max-width: 700px;

    margin: auto auto 20px;
}


.final-section p {
    color: var(--muted);
}


/* FOOTER */

footer {
    background: #2d2230;

    color: white;

    text-align: center;

    padding: 50px 30px;
}


.footer-logo {
    font-weight: 700;

    margin-bottom: 10px;
}


footer p {
    color: #cfc3d1;

    margin-bottom: 15px;
}


footer small {
    color: #9e929f;
}


/* ANIMAÇÃO */

@keyframes float {

    0%, 100% {
        transform: translateY(0);
    }

    50% {
        transform: translateY(-10px);
    }
}


/* MOBILE */

@media (max-width: 800px) {

    .nav-links {
        display: none;
    }


    .hero {
        grid-template-columns: 1fr;

        padding-top: 130px;
    }


    .hero-image {
        margin-top: 20px;
    }


    .image-card img {
        height: 450px;
    }


    .cards {
        grid-template-columns: 1fr;
    }


    .story-section {
        grid-template-columns: 1fr;

        gap: 40px;
    }


    .story-image img {
        height: 400px;
    }


    .help-cards {
        grid-template-columns: 1fr;
    }


    .quiz-container {
        padding: 25px;
    }


    .game-content h2,
    .help-content h2,
    .story-content h2 {
        font-size: 42px;
    }

}
